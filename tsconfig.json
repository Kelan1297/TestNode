{
  "compilerOptions": {
    "target": "ES2020",                      // Supporta async/await moderno
    "module": "CommonJS",                   // Compatibile con Node.js senza ES modules
    "moduleResolution": "node",             // Trova correttamente i moduli
    "esModuleInterop": true,                // Permette 'import express from "express"'
    "resolveJsonModule": true,              // Abilita tutte le verifiche TypeScript consigliate
    "outDir": "dist",                       // Dove andranno i file compilati
    "baseUrl": ".",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts"
  ],                   // Dove cercare i file sorgente
  "exclude": ["node_modules", "dist"]       // Esclude questi folder dalla compilazione
}
